  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": ["error", "trace_id"],
        "properties": {
          "error": {
            "type": "string"
          },
          "trace_id": {
            "type": "string"
          }
        }
      },
      "Capabilities": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "os",
          "arch",
          "cpu_cores",
          "memory_mb",
          "agent_version",
          "runtimes"
        ],
        "properties": {
          "os": {
            "enum": ["linux", "windows", "darwin"]
          },
          "arch": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "cpu_cores": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4096
          },
          "memory_mb": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16777216
          },
          "agent_version": {
            "const": "0.1.0"
          },
          "runtimes": {
            "type": "array",
            "maxItems": 1,
            "items": {
              "enum": ["synthetic-hash-v1"]
            }
          }
        }
      },
      "Enrollment": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "public_key", "signature", "capabilities"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "public_key": {
            "type": "string",
            "description": "Base64 raw 32-byte Ed25519 key"
          },
          "signature": {
            "type": "string",
            "maxLength": 128
          },
          "capabilities": {
            "$ref": "#/components/schemas/Capabilities"
          }
        }
      },
      "SharingPolicy": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cpu_percent", "memory_mb", "gpu_enabled", "idle_only"],
        "properties": {
          "cpu_percent": {
            "type": "integer",
            "minimum": 10,
            "maximum": 100
          },
          "memory_mb": {
            "type": "integer",
            "minimum": 64,
            "maximum": 1024
          },
          "gpu_enabled": {
            "const": false
          },
          "idle_only": {
            "const": false
          }
        }
      },
      "StartSharing": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "device_id",
          "duration_seconds",
          "policy",
          "consent_version",
          "accepted"
        ],
        "properties": {
          "device_id": {
            "type": "string",
            "format": "uuid"
          },
          "duration_seconds": {
            "enum": [3600, 7200, 14400, 21600, 28800, 43200]
          },
          "policy": {
            "$ref": "#/components/schemas/SharingPolicy"
          },
          "consent_version": {
            "const": "sharing-v1"
          },
          "accepted": {
            "const": true
          }
        }
      },
      "SyntheticJob": {
        "type": "object",
        "additionalProperties": false,
        "required": ["idempotency_key", "workload_type", "seed", "iterations"],
        "properties": {
          "idempotency_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "workload_type": {
            "const": "synthetic-hash-v1"
          },
          "seed": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-zA-Z0-9 _.-]+$"
          },
          "iterations": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30,
            "default": 10
          }
        }
      }
    }
  }
}
