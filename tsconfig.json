{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "plugins": [{ "name": "next" }]
  },
  "include": [
    "services/**/*.ts",
    "packages/**/*.ts",
    "tests/**/*.ts",
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "apps/company-console/.next/types/**/*.ts"
  ],
  "exclude": ["node_modules", "**/.next/**"]
}
