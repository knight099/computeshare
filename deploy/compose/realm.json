{
  "realm": "opencompute",
  "enabled": true,
  "registrationAllowed": false,
  "sslRequired": "external",
  "roles": {
    "realm": [
      {
        "name": "operator_admin"
      },
      {
        "name": "operator_support"
      },
      {
        "name": "auditor"
      },
      {
        "name": "workload_submitter"
      },
      {
        "name": "contributor"
      }
    ]
  },
  "clients": [
    {
      "clientId": "opencompute-console",
      "name": "OpenCompute PKCE console",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:3000/"],
      "webOrigins": ["http://localhost:3000"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "opencompute-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "opencompute-agent",
      "name": "OpenCompute native agent PKCE",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://127.0.0.1:8787/callback"],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "opencompute-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ]
}
