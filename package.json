{
  "name": "opencompute",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:api": "node --import tsx services/api/src/main.ts",
    "dev:console": "next dev apps/company-console -H 0.0.0.0 -p 3000",
    "build": "tsc --noEmit && next build apps/company-console",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "node --import tsx --test --test-isolation=none --test-concurrency=1 tests/unit/*.test.ts",
    "test:integration": "node --import tsx --test --test-isolation=none --test-concurrency=1 tests/integration/*.test.ts",
    "migrate": "node --import tsx services/api/src/migrate.ts",
    "test:e2e": "node tests/end-to-end/enrollment.mjs"
  },
  "dependencies": {
    "@fastify/websocket": "11.3.7",
    "fastify": "5.12.8",
    "jose": "6.2.17",
    "nats": "2.29.3",
    "next": "16.4.6",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "redis": "6.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "ws": "8.23.0"
  },
  "type": "module"
}
